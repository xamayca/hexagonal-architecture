{
    "name": "xamayca/doomdash",
    "description": "A self-hosted dashboard for managing and monitoring your services, system information, media, weather, and more.",
    "version": "0.1.0",
    "type": "project",
    "keywords": [
        "php",
        "hexagonal",
        "architecture",
        "ports",
        "adapters",
        "dashboard",
        "widget"
    ],
    "homepage": "https://github.com/xamayca/doomdash",
    "license": "MIT",
    "authors": [
        {
            "name": "xamayca",
            "email": "christopher.hariouat@gmail.com",
            "homepage": "https://github.com/xamayca",
            "role": "Developer"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/xamayca/doomdash"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test:unit": "@test --testsuite=Unit",
        "test:integration": "@test --testsuite=Integration",
        "test:functional": "@test --testsuite=Functional"
    }
}
